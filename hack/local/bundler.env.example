# Local bundler config — copy to hack/local/bundler.env and fill in the secret.
#
#   cp hack/local/bundler.env.example hack/local/bundler.env
#   # edit hack/local/bundler.env, then:
#   make run-bundler
#
# `make run-bundler` sources hack/local/bundler.env when it exists. The real
# file is gitignored; this example is committed and holds NO secrets.
#
# These values must agree with orbital's deploy/local/orbital.env. Orbital's
# ORBITAL_AUTH_PROVIDERS names which client ids it will accept a bearer token
# from — locally that is `armada-orbital`, with audience `armada-orbital`. A
# token from any other client is refused regardless of whether it is valid.

# Where orbital is. No trailing slash. Include the base path if orbital is
# mounted under one (AKS: http://localhost:8001/orbital).
ORBITAL_BASE_URL=http://localhost:8001

BUNDLER_PORT=8020

# ── Auth ─────────────────────────────────────────────────────────────────────
#
# Orbital enforces bearer auth on /graphql and /api/v1 whenever
# ORBITAL_AUTH_PROVIDERS is set — including when ORBITAL_DEV=true. Dev mode does
# NOT bypass it once providers are configured (auth v2, 2026-09-22), so the
# bundler needs a real token locally.

# Keycloak, not Entra. TOKEN_URL is REQUIRED for Keycloak: with it empty the
# bundler derives an Entra-shaped endpoint (issuer + /oauth2/v2.0/token) and
# talks to login.microsoftonline.com.
ORBITAL_OIDC_ISSUER_URL=https://keycloak.devnew.armada.ai/realms/armada
ORBITAL_TOKEN_URL=https://keycloak.devnew.armada.ai/realms/armada/protocol/openid-connect/token

# Must be a client orbital's ORBITAL_AUTH_PROVIDERS accepts (azp is the anchor).
ORBITAL_OIDC_CLIENT_ID=armada-orbital

# The client SECRET VALUE from Keycloak — not the secret id, and not an Entra
# secret. Keycloak: Clients → armada-orbital → Credentials → Client secret.
ORBITAL_OIDC_CLIENT_SECRET=

# REQUIRED for Keycloak. Empty falls back to Entra's api://{clientId}/.default,
# which Keycloak rejects as an unknown scope.
ORBITAL_TOKEN_SCOPE=openid

# ── Alternative: paste a token instead of client credentials ────────────────
# Takes priority over everything above; handy for a quick check with a token
# copied from the browser. Short-lived.
#ORBITAL_BEARER_TOKEN=
